# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnp
POSTGRES_PASSWORD=bnp_secret
POSTGRES_DB=bnp_decision_guard

# ---- API ----
# NODE_ENV=production makes the API fail-fast if any secret below is missing
# or left at its shipped default (JWT secrets, POSTGRES_PASSWORD, S3_SECRET_KEY).
NODE_ENV=development
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Security ----
# Comma-separated allowlist of browser origins permitted to call the API.
# In production this MUST be set explicitly; empty blocks all cross-origin calls.
CORS_ORIGINS=http://localhost:3000
# Per-IP rate limits (window seconds / max requests / stricter max on /auth/*)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
# Max JSON request body size (uploads use multipart and are capped separately)
REQUEST_BODY_LIMIT=25mb
# Per-account brute-force lockout: lock after N consecutive failed logins,
# for this many minutes (complements the per-IP rate limit above)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Password reset token lifetime (minutes)
PASSWORD_RESET_TOKEN_MINUTES=30

# ---- Email ----
# "log" (default) writes messages to the application log instead of sending —
# the whole reset flow works with no mail server, but links reach nobody.
# Switch to "smtp" before onboarding real users; production logs a warning
# while this is still "log".
MAIL_PROVIDER=log
MAIL_FROM=BNP Decision Guard <no-reply@bnp.health>
# Required when MAIL_PROVIDER=smtp (boot fails without it).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Absolute URL of the web app, used to build reset links. Defaults to the
# first CORS_ORIGINS entry, which is normally correct.
APP_BASE_URL=http://localhost:3000

# Local-demo escape hatch: return the reset token in the API response so the
# reset flow can be completed without a mail server. The token is otherwise
# never in the response — this endpoint is public, so disclosing it would let
# anyone who knows an email address take over that account. Never enable
# outside local development; it is refused in production regardless.
AUTH_DEV_RETURN_RESET_TOKEN=false

# --- Demo credentials -------------------------------------------------------
# The seeded demo accounts use passwords published in README.md. Under
# NODE_ENV=production the seed refuses to run and any account still carrying
# one of those passwords is disabled at boot. Both escape hatches below are
# for throwaway demos holding no real data; leave them unset otherwise.
# SEED_ALLOW_PRODUCTION=true
# ALLOW_DEMO_ACCOUNTS=true

# ---- MinIO / S3 ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bnp_minio
S3_SECRET_KEY=bnp_minio_secret
S3_BUCKET=bnp-documents
S3_FORCE_PATH_STYLE=true

# ---- AI / RAG ----
# Providers: mock (no API key needed) | openai
# IMPORTANT: after changing EMBEDDING_PROVIDER, run POST /rag/reindex (as a
# knowledge manager) — chunks embedded by the previous provider are excluded
# from retrieval, so the assistant refuses everything until the corpus is
# re-embedded with the active provider.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column dimension — vector(384) in the schema.
# text-embedding-3-small supports native 384-dim output via the API.
EMBEDDING_DIM=384
# Timeout per OpenAI-compatible request (one retry on 429/5xx/timeout)
OPENAI_TIMEOUT_MS=30000
# Indexing embeds a whole PDF at once, so long documents are split across
# several /embeddings requests rather than one oversized call the provider
# rejects with a 400. Both ceilings sit well under OpenAI's documented limits;
# lower them for a stricter self-hosted OpenAI-compatible endpoint.
EMBEDDING_BATCH_SIZE=96
EMBEDDING_BATCH_CHARS=200000
# Candidates pulled from pgvector, then narrowed to RAG_FINAL_K by the
# reranker. Scale TOP_K with the corpus: a net of 8 over a few hundred
# indexed chunks rarely reaches past the one document that repeats the
# query's terms most often.
RAG_TOP_K=8
RAG_FINAL_K=4
RAG_MIN_SIMILARITY=0.25

# --- PHI screening ---------------------------------------------------------
# The hospital's medical-record-number format, as a regular expression.
# Unset by default and the shipped state: the other four PHI patterns (national
# ID/Iqama, date of birth, Saudi mobile, identifying phrases) run regardless,
# and this one turns on with no code change once a real format is known.
# A value that does not compile fails the boot rather than silently disabling
# the check. Example: PHI_MRN_PATTERN=\bMR-[0-9]{6}\b
# PHI_MRN_PATTERN=
# Soft per-document cap on the final shortlist. Reference manuals name drugs
# constantly, so one document can otherwise occupy every slot and the answer
# gets built from a single source. A document may still exceed this once no
# other source has a qualifying chunk left; set it >= RAG_FINAL_K to disable.
RAG_MAX_PER_DOCUMENT=3

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
